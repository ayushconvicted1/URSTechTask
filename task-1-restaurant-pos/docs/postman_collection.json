{
  "info": {
    "name": "Restaurant POS & Order Management API",
    "description": "Postman collection for UrsTech SDE Task 1 - Restaurant POS & Order Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@urstechsolution.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login (Staff)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@urstechsolution.com\",\n  \"password\": \"staff123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Menu Management",
      "item": [
        {
          "name": "Get Menu Items (Filter / Search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu?category=Mains&search=burger&available=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu"],
              "query": [
                { "key": "category", "value": "Mains" },
                { "key": "search", "value": "burger" },
                { "key": "available", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Create Menu Item (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Artisan Pepperoni Flatbread\",\n  \"category\": \"Mains\",\n  \"price\": 13.50,\n  \"description\": \"Crispy thin crust with spicy pepperoni and hot honey\",\n  \"isAvailable\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/menu",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu"]
            }
          }
        },
        {
          "name": "Update Menu Item (Admin Only)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 14.00,\n  \"isAvailable\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/menu/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu", ":id"]
            }
          }
        },
        {
          "name": "Toggle Menu Item Availability (Admin Only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/menu/:id/toggle",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu", ":id", "toggle"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders & Billing",
      "item": [
        {
          "name": "Create Order (Validated Totals & Stock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderType\": \"dine-in\",\n  \"tableNumber\": \"Table 5\",\n  \"customerName\": \"John Doe\",\n  \"items\": [\n    {\n      \"menuItemId\": \"ITEM_ID_HERE\",\n      \"quantity\": 2\n    }\n  ],\n  \"taxRate\": 5,\n  \"discountRate\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Get Orders (Filter by status, search)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders?status=All&search=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                { "key": "status", "value": "All" },
                { "key": "search", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get Order By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", ":id"]
            }
          }
        },
        {
          "name": "Update Order Status (Workflow Transition)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Preparing\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", ":id", "status"]
            }
          }
        },
        {
          "name": "Record Payment (Cash / UPI / Card)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"UPI\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/:id/payment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", ":id", "payment"]
            }
          }
        }
      ]
    },
    {
      "name": "Reports & Dashboard",
      "item": [
        {
          "name": "Get Daily Sales Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/daily-sales",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "daily-sales"]
            }
          }
        }
      ]
    }
  ]
}
