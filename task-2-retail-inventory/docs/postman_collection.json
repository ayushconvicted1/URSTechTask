{
  "info": {
    "name": "Retail Inventory & Sales Management API",
    "description": "Postman collection for UrsTech SDE Task 2 - Retail Inventory & Sales Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@urstechsolution.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login (Staff)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@urstechsolution.com\",\n  \"password\": \"staff123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Product Management",
      "item": [
        {
          "name": "Get Products (Filter by Category, Stock Status, Search)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products?category=Electronics&stockStatus=low&search=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "category", "value": "Electronics" },
                { "key": "stockStatus", "value": "low" },
                { "key": "search", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Create Product (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"AUDIO-501\",\n  \"name\": \"Studio Monitor Headphones\",\n  \"category\": \"Electronics\",\n  \"purchasePrice\": 45.00,\n  \"sellingPrice\": 99.00,\n  \"availableStock\": 20,\n  \"reorderLevel\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "Update Product (Admin Only)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sellingPrice\": 105.00,\n  \"reorderLevel\": 6\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", ":id"]
            }
          }
        }
      ]
    },
    {
      "name": "Inventory & Stock Adjustments",
      "item": [
        {
          "name": "Get Low Stock Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/low-stock",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "low-stock"]
            }
          }
        },
        {
          "name": "Record Stock Received / Adjustment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"PRODUCT_ID_HERE\",\n  \"type\": \"RECEIVED\",\n  \"quantity\": 15,\n  \"reason\": \"Supplier restock delivery\",\n  \"referenceId\": \"PO-9912\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/inventory/adjustments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "adjustments"]
            }
          }
        },
        {
          "name": "Get Inventory Movements (Audit Log)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/movements?type=All&limit=25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "movements"],
              "query": [
                { "key": "type", "value": "All" },
                { "key": "limit", "value": "25" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Sales & Invoicing",
      "item": [
        {
          "name": "Create Sale (Stock Checked & Deducted)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"PRODUCT_ID_HERE\",\n      \"quantity\": 2\n    }\n  ],\n  \"discountAmount\": 5.00,\n  \"taxRate\": 5,\n  \"paymentMethod\": \"Card\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sales",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sales"]
            }
          }
        },
        {
          "name": "Get Sales Invoices (Date Filter / Search)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sales",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sales"]
            }
          }
        },
        {
          "name": "Get Sale Details By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sales/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sales", ":id"]
            }
          }
        },
        {
          "name": "Process Sale Return (Bonus: Stock Restored)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Customer requested refund - unopened packaging\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sales/:id/return",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sales", ":id", "return"]
            }
          }
        }
      ]
    },
    {
      "name": "Reports & Analytics",
      "item": [
        {
          "name": "Get Sales Report (Totals & Top Selling)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/sales",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "sales"]
            }
          }
        },
        {
          "name": "Get Profit & Margin Report (COGS & Gross Profit)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/profit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "profit"]
            }
          }
        },
        {
          "name": "Export Sales as CSV (Bonus Feature)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/sales/csv",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "sales", "csv"]
            }
          }
        }
      ]
    }
  ]
}
